# Local Resume Builder and Analyzer Configuration
# Optional Sarvam AI insights (local analysis works without this key).
SARVAM_API_KEY=your_sarvam_api_key_here
# Optional model override; defaults to sarvam-105b.
# SARVAM_MODEL=sarvam-105b

# Directory paths for custom local models and datasets
DATA_DIR=data
MODELS_DIR=models

# Flag to enable custom trained machine learning models when available in models/
USE_CUSTOM_MODEL=false
